rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ─────────────────────────────────────────────────────────
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    // The single owner account may bootstrap itself as admin on first login;
    // everyone else must be a customer. Verified against the signed-in email.
    function isOwnerEmail() {
      return request.auth.token.email != null &&
             request.auth.token.email.lower() == 'hello.automodz@gmail.com';
    }
    // Staff = admin or a linked employee account. The employee role is granted
    // ONLY server-side (/api/employee/link, admin SDK) - rules still forbid
    // self-escalation on the users collection.
    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isStaff() {
      return userDoc().role in ['admin', 'employee'];
    }
    function myEmployeeId() {
      return userDoc().employeeId;
    }
    // Vehicles live under the owner's document, so ownership is a lookup.
    // Used by the visit/protection rules, which are keyed by vehicle.
    function ownsVehicle(vehicleId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/vehicles/$(vehicleId));
    }

    // ── Users ───────────────────────────────────────────────────────────
    // Self-service profile, but `role` can never be self-escalated.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId &&
        (request.resource.data.role == 'customer' ||
         (request.resource.data.role == 'admin' && isOwnerEmail()));
      // A customer may edit their own profile but may NOT set their own
      // `welcomedAt` — that is written only by POST /api/welcome/complete,
      // which is also the only place the studio's reset lives. A client that
      // could write it could skip its own first arrival, or force somebody
      // else's back by clearing it.
      //
      // `upiVpa` and `quietMode` are server-written too, and for reasons rules
      // cannot cover. A malformed payment address is not a cosmetic problem —
      // it is a customer tapping "Pay" at the counter and their bank
      // application refusing to open. And `quietMode` is read BY THE SERVER
      // when it decides whether a push may be delivered, so a preference the
      // server must honour is one the server should own: "it saved" and "it
      // took effect" are then the same event rather than two.
      // POST /api/profile/preferences is the door.
      allow update: if request.auth != null &&
        ((request.auth.uid == userId &&
          request.resource.data.role == resource.data.role &&
          request.resource.data.get('welcomedAt', null) ==
            resource.data.get('welcomedAt', null) &&
          request.resource.data.get('upiVpa', null) ==
            resource.data.get('upiVpa', null) &&
          request.resource.data.get('quietMode', null) ==
            resource.data.get('quietMode', null)) ||
         isAdmin());
      allow delete: if request.auth != null && isAdmin();

      // Saved cars (favourites on car listings)
      // Read by the owner; written ONLY by POST /api/cars/save, because the
      // saved list is read server-side when the marketplace renders.
      match /savedCars/{listingId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Web-push device tokens - owner writes, admin reads (server uses admin SDK anyway)
      match /fcmTokens/{token} {
        allow read, write: if request.auth != null && (request.auth.uid == userId || isAdmin());
      }

      // ── SAVED PICKUP / DROP ADDRESSES ────────────────────────────────
      //    Design screens 08 and 19. Owner-read; SERVER-WRITE ONLY, and the
      //    two reasons are rules that cannot be written as rules:
      //
      //      · Exactly one default. Making one address the default has to
      //        stand the others down, which is a write to documents the
      //        request never named. A client doing it in two writes leaves
      //        two defaults the first time one of them fails.
      //      · An address a van is due at on Tuesday may not be deleted.
      //        Rules cannot query, so they cannot know that.
      //
      //    POST/DELETE /api/addresses is the only door. Staff are NOT given a
      //    read: a customer's home address is not operational data, and the
      //    driver gets the snapshot the booking carries.
      match /addresses/{addressId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      // Vehicles subcollection
      match /vehicles/{vehicleId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && (request.auth.uid == userId || isAdmin());

        // Vehicle service history (written by admin, readable by owner/admin)
        match /serviceHistory/{recordId} {
          allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
          allow create, update, delete: if request.auth != null && isAdmin();
        }

        // ── CONSENT LOG ──────────────────────────────────────────────────
        //    Permission to publish this car's service record (screen 17) is
        //    the owner's alone, and every change is kept forever so the
        //    question "was this public on the day that buyer saw it" has an
        //    answer. APPEND-ONLY: not even the owner may edit or delete an
        //    entry, because a consent trail that can be rewritten is not a
        //    trail. The studio cannot write here at all — an admin who could
        //    grant consent on a customer's behalf would defeat the point of
        //    asking. See lib/os/consent.ts.
        match /consentLog/{eventId} {
          allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
          allow create: if request.auth != null && request.auth.uid == userId;
          allow update, delete: if false;
        }
      }
    }

    // ── Bookings ─────────────────────────────────────────────────────────
    //    CREATE IS SERVER-ONLY (/api/booking/create → the Booking Service).
    //    The old rule allowed any customer to create a booking whose `userId`
    //    was their own - which these rules can check - carrying any
    //    `totalAmount`, `discount` and `serviceBasePrice` they liked, which
    //    rules cannot. A ₹2,20,000 PPF for ₹1 satisfied every condition here.
    //    Rules can validate shape; only a server can validate arithmetic. So
    //    the arithmetic moved, and this door closed.
    //    UPDATE IS SERVER-ONLY TOO, NOW.
    //    The previous rule let the owner write `scheduledDate` and
    //    `scheduledTime` directly, on the grounds that it could check WHICH
    //    keys changed. It could not check their values, and every value here
    //    is a business rule: the destination must be a slot that exists, that
    //    the studio is not already working, and that is more than 24 hours
    //    away — measured against the booking's own timestamp on a clock the
    //    customer does not control. A browser deciding any of those is a
    //    browser deciding whether a bay is free.
    //    Cancelling was equally unsound here: a cancellation must return the
    //    membership wash and the promo the booking spent, and those live on
    //    documents a customer may not touch, so a client-side cancel silently
    //    destroyed an entitlement the customer had paid for.
    //    Both go through the Booking Service: /api/booking/reschedule and
    //    /api/booking/cancel. Rules can validate shape; only a server can
    //    validate a bay.
    match /bookings/{bookingId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false;
      allow update: if request.auth != null && isAdmin();
      allow delete: if request.auth != null && isAdmin();
    }

    // ── Approvals - the studio asks, the CUSTOMER answers (screen 12) ───
    //    The only place a customer agrees to spend more after the work has
    //    started, so every door here is deliberately narrow.
    //
    //    NOBODY WRITES FROM A CLIENT. Not the customer, and not the studio:
    //      · A customer answering directly would set `status` and skip the
    //        propagation entirely — the job's total, the booking's total and
    //        the breakdown behind them all move in the SAME commit as the
    //        answer, and rules cannot do that. The job would keep the old
    //        figure and the approval would claim the new one.
    //      · The studio writing directly could set `status: 'approved'`, which
    //        is the studio answering for the customer. `APPROVAL_ACTORS` in
    //        lib/os/lifecycle.ts refuses that, and the refusal is only worth
    //        anything if there is no way around it.
    //
    //    /api/approval is the one door: POST to ask (staff), PATCH to answer
    //    (owner). Reading is the owner's and the studio's — the customer must
    //    see what they are being asked, and the bay must see the answer.
    match /approvals/{id} {
      allow read: if request.auth != null &&
        (isStaff() || resource.data.customerId == request.auth.uid);
      allow write: if false;
    }

    // ── Estimates - what a customer was quoted (design screen 07) ───────
    //    OWNER-READ, SERVER-WRITE. An estimate is a PRICE, and the whole
    //    reason it is a stored object rather than a number in a query string
    //    is that a price a client can express is not a price. Rules can check
    //    that `total` is a number; they cannot check that it is the number
    //    `priceVisit` would produce from the catalogue, the customer's
    //    membership and the one promo that applies. So no client writes here
    //    at all - POST /api/estimate is the only door, and it never reads a
    //    figure off the request.
    //
    //    Reading is scoped to the owner. An estimate names what a customer is
    //    about to spend and which car they are spending it on; there is no
    //    reason for anyone else to hold it, including another customer who
    //    happens to guess an id.
    match /estimates/{id} {
      allow read: if request.auth != null &&
        (isStaff() || resource.data.userId == request.auth.uid);
      allow write: if false;
    }

    // ── Visits - THE ANCHOR (docs/VISIT-OBJECT.md) ──────────────────────
    //    A visit is append-only while it runs and PERMANENT once sealed.
    //    The seal is what makes a promise unrewritable: after `sealedAt`,
    //    no client may touch the record - not the terms it captured, not
    //    the amounts, not the stages. Sealing itself runs server-side.
    function visitIsSealed() {
      return resource.data.sealedAt != null;
    }
    //  READ IS BY VEHICLE OWNERSHIP, NOT BY AN OWNER FIELD ON THE VISIT.
    //  The predecessor read `resource.data.customerId` / `.userId`, and a Visit
    //  carries NEITHER - the type has no such field and nothing writes one. So
    //  the condition could never be true for a customer, and because Firestore
    //  denies a whole QUERY when any matched document fails its rule, the first
    //  visit ever written would have broken every customer's every room at
    //  once. A visit is keyed by `vehicleId` and vehicles live under their
    //  owner, so ownership is the same lookup `protections` already uses.
    match /visits/{id} {
      allow read: if request.auth != null &&
        (isStaff() || ownsVehicle(resource.data.vehicleId));
      allow create: if request.auth != null && isStaff();
      // staff may advance an OPEN visit; a sealed one is closed to everyone
      allow update: if request.auth != null && isStaff() && !visitIsSealed() &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['sealedAt', 'termsCaptured', 'amounts']);
      allow delete: if request.auth != null && isAdmin();
    }

    // ── Protections - the promises shielding a car ──────────────────────
    //    Physical protection is created by a sealing visit (server-side);
    //    the owner may declare and remove their OWN papers - insurance,
    //    PUC, RC, FASTag - which AutoModz did not sell.
    match /protections/{id} {
      allow read: if request.auth != null &&
        (isStaff() || ownsVehicle(resource.data.vehicleId));
      allow create, update: if request.auth != null &&
        (isStaff() ||
         (ownsVehicle(request.resource.data.vehicleId) &&
          // an owner may only ever declare - never forge a captured term,
          // which is the studio's own record of what it sold
          request.resource.data.termsSource == 'declared' &&
          !(request.resource.data.keys().hasAny(['visitId']))));
      allow delete: if request.auth != null &&
        (isAdmin() || ownsVehicle(resource.data.vehicleId));
    }

    // ── Services - anyone authenticated reads, only admin writes ────────
    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }

    // ── Subscriptions - owner may cancel their own; admin manages all ───
    match /subscriptions/{subId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      // Self-purchase always lands as 'pending' - only admin verifies payment
      // and activates (audit S6 #1: no honor-system activation).
      allow create: if request.auth != null &&
        (isAdmin() ||
         (request.resource.data.userId == request.auth.uid &&
          request.resource.data.status == 'pending'));
      allow update: if request.auth != null &&
        (isAdmin() ||
         (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'updatedAt']) &&
          request.resource.data.status == 'cancelled'));
      allow delete: if request.auth != null && isAdmin();
    }

    // ── Gallery - PUBLIC read (logged-out landing page), admin write ────
    match /gallery/{imageId} {
      allow read: if true;
      allow write: if request.auth != null && isAdmin();
    }

    // ── Notifications - recipient reads and marks read; admin writes ────
    //    `update` was unscoped, so a recipient could rewrite the title, body
    //    or type of a notification the studio sent them. Marking something
    //    read is the only edit a reader is owed.
    match /notifications/{notifId} {
      allow read: if request.auth != null &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow update: if request.auth != null &&
        (isAdmin() ||
         (resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])));
      allow create, delete: if request.auth != null && isAdmin();
    }

    // ── Referrals - created ONLY server-side via /api/referral/claim ────
    // (admin SDK bypasses rules). Clients read their own records.
    match /referrals/{refId} {
      allow read: if request.auth != null &&
        (resource.data.referrerUid == request.auth.uid ||
         resource.data.referredUid == request.auth.uid ||
         isAdmin());
      allow write: if request.auth != null && isAdmin();
    }

    // ── Internal operations ─────────────────────────────────────────────
    // Staff read the roster (kiosk PIN list, assignment pickers); admin writes.
    // authUid backlink happens via the admin SDK route, not the client.
    match /employees/{id}      { allow read: if request.auth != null && isStaff();
                                 allow write: if request.auth != null && isAdmin(); }
    // Employees manage their own attendance from their phones.
    match /attendance/{id} {
      allow read: if request.auth != null && isStaff();
      allow create: if request.auth != null &&
        (isAdmin() || (isStaff() && request.resource.data.employeeId == myEmployeeId()));
      allow update: if request.auth != null &&
        (isAdmin() || (isStaff() && resource.data.employeeId == myEmployeeId()));
      allow delete: if request.auth != null && isAdmin();
    }
    match /payroll/{id}        { allow read, write: if request.auth != null && isAdmin(); }
    match /expenses/{id}       { allow read, write: if request.auth != null && isAdmin(); }
    // Phone-keyed CRM records for accountless walk-ins - staff maintain at intake
    match /walkinCustomers/{id} { allow read, write: if request.auth != null && isStaff(); }

    // Quotes - customers may file a REQUEST for themselves; staff run the pipeline
    match /quotes/{id} {
      allow create: if request.auth != null &&
        (isStaff() ||
         (request.resource.data.status == 'requested' &&
          request.resource.data.customerId == request.auth.uid &&
          request.resource.data.total == 0));
      allow read: if request.auth != null &&
        (isStaff() || resource.data.customerId == request.auth.uid);
      allow update, delete: if request.auth != null && isStaff();
    }

    // Follow-up tasks - owner's queue
    match /tasks/{id} { allow read, write: if request.auth != null && isStaff(); }

    // ── Studio resource config (wash capacity etc.) - staff read, admin writes.
    //    Customers never read it directly; availability flows through the API. ──
    match /studioConfig/{id} {
      allow read: if request.auth != null && isStaff();
      allow write: if request.auth != null && isAdmin();
    }

    // Private feedback from the public invoice rating - anyone may create a
    // shape-valid entry; only admin reads
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly([
          'rating', 'comment', 'invoiceId', 'customerName', 'customerPhone', 'createdAt'
        ])
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && (!('comment' in request.resource.data) || request.resource.data.comment.size() <= 1000);
      allow read, update, delete: if request.auth != null && isAdmin();
    }
    match /dailyClosings/{id}  { allow read, write: if request.auth != null && isAdmin(); }
    // Jobs: staff see the whole board; only ASSIGNED employees may write, and
    // only operational fields - amounts, discounts, assignments stay admin-only.
    match /jobs/{id} {
      // Staff see the board; a customer may follow their OWN job (the Live
      // Care tracker) - same "reads their own" pattern as invoices.
      allow read: if request.auth != null &&
        (isStaff() || resource.data.customerId == request.auth.uid);
      // Employees may create jobs; any discount must be system-computed
      // (membership/promo) - there is no manual discount path for staff.
      allow create: if request.auth != null &&
        (isAdmin() ||
         (isStaff() &&
          (!('discount' in request.resource.data) ||
           request.resource.data.discount.source in ['membership', 'promo'])));
      allow update: if request.auth != null &&
        (isAdmin() ||
         (isStaff() && resource.data.assignedIds.hasAny([myEmployeeId()]) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(
            ['status', 'statusHistory', 'photos', 'notes', 'bay',
             'paymentStatus', 'paymentMethod', 'transactionId', 'invoiceId',
             'payments', 'amountPaid', 'completedAt', 'updatedAt'])));
      allow delete: if request.auth != null && isAdmin();
    }
    match /inventoryItems/{id} { allow read: if request.auth != null && isStaff();
                                 allow write: if request.auth != null && isAdmin(); }
    // Consumption txns are written by staff on job completion.
    match /inventoryTxns/{id}  { allow read: if request.auth != null && isStaff();
                                 allow create: if request.auth != null && isStaff();
                                 allow update, delete: if request.auth != null && isAdmin(); }
    match /serviceRecipes/{id} { allow read: if request.auth != null && isStaff();
                                 allow write: if request.auth != null && isAdmin(); }
    // Invoice-number counter - bumped by staff when generating an invoice.
    match /counters/{id}       { allow read, write: if request.auth != null && isStaff(); }

    // ── Invoices - staff create at the kiosk; customer reads their own;
    //    public link via admin-SDK route ──
    match /invoices/{id} {
      allow read: if request.auth != null &&
        (isStaff() || resource.data.customerId == request.auth.uid);
      allow create: if request.auth != null && isStaff();
      allow update, delete: if request.auth != null && isAdmin();
    }

    // ── Promos - authenticated read, admin write. Nothing else.
    //    A promo is COUNTED only by the Booking Service, in the same commit as
    //    the booking or job that spends it. The old rule allowed any signed-in
    //    client to write `usedCount` as long as the new value was old+1 - an
    //    increment primitive handed to the public, with no check that a
    //    redemption had occurred. One loop exhausted every promo in the system,
    //    and referral rewards are usageLimitTotal:1. Clients read promos so the
    //    app can QUOTE one; they never count them.
    match /promos/{id} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && isAdmin();
    }
    match /promoRedemptions/{id} {
      // Customers may read their OWN redemptions - `getEligiblePromos` counts
      // them to quote a per-customer-limited promo honestly. Writes are the
      // Booking Service's alone; a self-written redemption is a forged one.
      allow read: if request.auth != null &&
        (isAdmin() || resource.data.userId == request.auth.uid);
      allow write: if request.auth != null && isAdmin();
    }

    // ── Booking intents - the idempotency ledger. Written and read only by the
    //    Booking Service (admin SDK, which bypasses these rules). No client has
    //    any business here: a client that could delete its own marker could
    //    replay a booking, and one that could forge a marker could suppress a
    //    real one.
    match /bookingIntents/{id} {
      allow read, write: if false;
    }

    // ── Car listings - PUBLIC read of active listings (logged-out /cars) ──
    match /carListings/{id} {
      allow read: if resource.data.active == true ||
        (request.auth != null && isAdmin());
      allow write: if request.auth != null && isAdmin();
    }

    // ── Car leads - public inquiry form with field-shape validation ─────
    // Created ONLY by POST /api/cars/lead, which uses the Admin SDK and is not
    // subject to these rules. This used to allow unauthenticated create so the
    // public form could work — an open write endpoint wired straight to the
    // studio's WhatsApp. The form now posts to the route instead.
    match /carLeads/{id} {
      allow create: if false;
      allow read, update, delete: if request.auth != null && isAdmin();
    }

    // ── Sell requests - customer creates/reads own; admin manages ───────
    // Created ONLY by POST /api/cars/sell. A client create could name its own
    // status and skip the notification the studio depends on.
    match /sellRequests/{id} {
      allow create: if false;
      allow read: if request.auth != null &&
        (isAdmin() || resource.data.userId == request.auth.uid);
      allow update, delete: if request.auth != null && isAdmin();
    }

    // ── Activity - the operational event log (the workspace timeline).
    //    Append-only: staff create + read; admin may amend/prune. ────────
    match /activity/{id} {
      // Customers may read events on their own record (tracker timeline).
      allow read:   if request.auth != null &&
        (isStaff() || resource.data.customerId == request.auth.uid);
      allow create: if request.auth != null && isStaff();
      allow update, delete: if request.auth != null && isAdmin();
    }
  }
}
