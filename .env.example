# ══════════════════════════════════════════════════════════════════════════
# AutoModz environment - everything here has a FREE tier. See FIREBASE_GUIDE.md
# for click-by-click instructions on getting each value.
# ══════════════════════════════════════════════════════════════════════════

# ── 1. Firebase web app config (REQUIRED) ──────────────────────────────────
# Firebase console → Project settings (gear icon) → General → Your apps → Web app
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# (Firebase Storage removed - images use Cloudinary)
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Email that becomes admin on first sign-in
NEXT_PUBLIC_ADMIN_EMAIL=hello.automodz@gmail.com

# ── 2. Firebase Admin SDK (REQUIRED for invoices links, push, referrals) ───
# Firebase console → Project settings → Service accounts → Generate new private key
# Copy values from the downloaded JSON. Keep the \n characters in the private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# ── 3. Web push (OPTIONAL but recommended - free) ──────────────────────────
# Firebase console → Project settings → Cloud Messaging → Web Push certificates
# → Generate key pair. Paste the key here.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ── 4. Image hosting (pick ONE) ────────────────────────────────────────────
# Option A (recommended, 100% free, NO credit card): Cloudinary
#   cloudinary.com → free account → Dashboard shows your Cloud name.
#   Settings → Upload → Upload presets → Add preset → Mode: Unsigned → save,
#   then paste its name below. When these two are set, ALL photos (cars,
#   gallery, job before/after, sell requests) go to Cloudinary automatically.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
# Option B: Firebase Storage - leave the two Cloudinary vars empty. Note that
#   new Firebase projects require the Blaze plan (card on file) for Storage;
#   usage still costs ₹0 within the free quotas.

# ── 5. Payments & contact (already working defaults) ───────────────────────
NEXT_PUBLIC_UPI_ID=automodz@upi
NEXT_PUBLIC_WHATSAPP_NUMBER=919512605088

# ── 6. WhatsApp Cloud API (OPTIONAL - advanced) ────────────────────────────
# Leave empty to keep using free wa.me tap-to-send links (default).
# developers.facebook.com → create app → WhatsApp → API Setup.
# Free-form replies work in the 24h customer-service window; template messages
# outside it need Meta approval and carry a small per-message fee.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
